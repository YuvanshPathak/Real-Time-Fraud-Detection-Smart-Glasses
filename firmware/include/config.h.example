#ifndef CONFIG_H
#define CONFIG_H

// Copy this file to config.h (gitignored — never commit real credentials) and
// fill in real values before building.

// ─── Wi-Fi Credentials ──────────────────────────────────────────────────────
#define WIFI_SSID      "YOUR_WIFI_SSID"
#define WIFI_PASSWORD  "YOUR_WIFI_PASSWORD"

// ─── Backend Base URL ───────────────────────────────────────────────────────
// No trailing slash. Backend must be started with --host 0.0.0.0 to be
// reachable from the device, not just localhost.
#define BACKEND_URL    "http://192.168.1.100:8000"

// ─── Audio ───────────────────────────────────────────────────────────────────
#define SAMPLE_RATE        16000
#define RECORD_SECONDS     5

// ─── PDM Microphone Pins (XIAO ESP32-S3 Sense) ───────────────────────────────
#define MIC_DATA_PIN       GPIO_NUM_41
#define MIC_CLK_PIN        GPIO_NUM_42

// ─── Alert LED (onboard LED on XIAO ESP32-S3) ────────────────────────────────
// Visual stand-in for the bone-conduction speaker (not yet built).
#define ALERT_LED_PIN      21

// ─── Timing ───────────────────────────────────────────────────────────────────
#define LOOP_INTERVAL_MS   10000

#endif
