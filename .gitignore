# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Uploads (keep folder tracked via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# Temporary debug-only voice recordings (routes/voice.py) — never commit
# captured audio. Remove this along with the debug code once mic capture
# is confirmed reliable — see CLAUDE.md's fresh-analysis rule.
backend/debug_recordings/

# Session log DB (verdict metadata only, no biometric data — utils/session_log.py)
backend/session_log.db

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Microsoft Office lock files (created while a doc is open, not real content)
~$*

# Node dependencies (tools/ has its own package.json for report generation)
node_modules/

# PlatformIO build artifacts (firmware/ also has its own .gitignore for this)
.pio/

#global
/*.txt

# ─── ML Models & Large Binaries ──────────────────────────────────────────────
# DeepFace / SpeechBrain download model weights at runtime — never commit them.
backend/pretrained_models/
backend/.deepface/

# Common ML weight / checkpoint extensions
*.ckpt
*.pt
*.pth
*.pb
*.h5
*.tflite
*.onnx
*.bin
*.safetensors

archive/*

# ─── ml/ training pipeline ───────────────────────────────────────────────────
# Generated/regeneratable — see ml/README.md. The exported C headers under
# firmware/include/ (voice_tinyml_model.h, tinyml_feature_config.h) ARE
# committed, since the firmware build can't generate them itself.
ml/data/
ml/output/